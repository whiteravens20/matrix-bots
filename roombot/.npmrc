# Supply-chain hardening.
# Block install and postinstall scripts. One dependency needs its own:
# @matrix-org/matrix-sdk-crypto-nodejs downloads its native library in
# postinstall, and matrix-bot-sdk fails to load without it. After `npm ci`, run
# that one script:
#   npm rebuild @matrix-org/matrix-sdk-crypto-nodejs --ignore-scripts=false
# The Docker build does not read this file, so its `npm ci` runs the script.
ignore-scripts=true

# Refuse to resolve a version published less than 7 days ago. This is the
# backstop: it fires at resolution (`npm install`, `npm update`), not on
# `npm ci`, which installs exactly what the lockfile already pins. Dependabot
# is held back upstream by `cooldown` in .github/dependabot.yml.
min-release-age=7

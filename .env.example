# Matrix Homeserver
MATRIX_HOMESERVER=https://matrix.example.com

# DM Bot (for private direct messages)
DMBOT_USER_ID=@dmbot:example.com
DMBOT_ACCESS_TOKEN=DMBOT_ACCESS_TOKEN_HERE
DMBOT_ALLOWED_USERS=@user1:example.com,@user2:example.com

# Room Bot (for group conversations)
ROOMBOT_USER_ID=@roombot:example.com
ROOMBOT_ACCESS_TOKEN=ROOMBOT_ACCESS_TOKEN_HERE
TARGET_ROOM_ID=!roomIdHash:example.com

# n8n Integration (optional)
# Set this to your n8n webhook URL to trigger workflows on incoming messages
# For Docker: http://n8n:5678/webhook/matrix-bot
# For local n8n: http://localhost:5678/webhook/matrix-bot
N8N_WEBHOOK_URL=http://n8n:5678/webhook/matrix-bot

# Bot Response Prefixes (optional, for multi-LLM identification)
# DM Bot prefixes
BOT_RESPONSE_PREFIX=[DM Bot]
BOT_GENERAL_PREFIX=[Assistant]
BOT_CODE_PREFIX=[Code Expert]
BOT_TRANSLATE_PREFIX=[Translator]
BOT_ANALYZE_PREFIX=[Analyst]

# Room Bot prefixes
BOT_RESPONSE_PREFIX=[Room Bot]
BOT_GENERAL_PREFIX=[Room Assistant]
BOT_MODERATE_PREFIX=[Moderator]
BOT_ANNOUNCE_PREFIX=[Announcement]

# Custom Help Text (optional, multiline not supported in env - uses default from config)
# BOT_HELP_TEXT=Custom help text here

# n8n Basic Auth (optional, recommended for production)
N8N_BASIC_AUTH_ACTIVE=false
N8N_USER=admin
N8N_PASSWORD=changeme

# Matrix Homeserver
MATRIX_HOMESERVER=https://matrix.example.com

# DM Bot (for private direct messages)
# Choose ONE option below:

# Option 1: Use username/password (RECOMMENDED - auto-login, always fresh token)
DMBOT_USERNAME=dmbot
DMBOT_PASSWORD=your_secure_password_here

# Option 2: Use static access token (can become invalid if you login manually)
# DMBOT_ACCESS_TOKEN=syt_your_access_token_here

# Whitelist of allowed users (comma-separated, no spaces)
DMBOT_ALLOWED_USERS=@user1:example.com,@user2:example.com

# Room Bot (for group conversations)
# Choose ONE option below:

# Option 1: Use username/password (RECOMMENDED - auto-login, always fresh token)
ROOMBOT_USERNAME=roombot
ROOMBOT_PASSWORD=your_secure_password_here

# Option 2: Use static access token (can become invalid if you login manually)
# ROOMBOT_ACCESS_TOKEN=syt_your_access_token_here

# Target room ID (REQUIRED for Room Bot)
TARGET_ROOM_ID=!roomIdHash:example.com

# n8n Integration (optional)
# Set this to your n8n webhook URL to trigger workflows on incoming messages
# For Docker: http://n8n:5678/webhook/matrix-bot
# For local n8n: http://localhost:5678/webhook/matrix-bot
N8N_WEBHOOK_URL=http://n8n:5678/webhook/matrix-bot

# Answer prefixes (optional)
# The prefix in front of an answer: the general one, or the one that matches the
# agentType the workflow returned. Leave a line out to keep its default.
# DM bot
DMBOT_RESPONSE_PREFIX=[DM Bot]
DMBOT_GENERAL_PREFIX=[Assistant]
DMBOT_CODE_PREFIX=[Code Expert]
DMBOT_TRANSLATE_PREFIX=[Translator]
DMBOT_ANALYZE_PREFIX=[Analyst]

# Room bot
ROOMBOT_RESPONSE_PREFIX=[Room Bot]
ROOMBOT_GENERAL_PREFIX=[Room Assistant]
ROOMBOT_MODERATE_PREFIX=[Moderator]
ROOMBOT_ANNOUNCE_PREFIX=[Announcement]

# Help text answered to !help (optional, one line; the default lists the commands)
# DMBOT_HELP_TEXT=Custom help text here
# ROOMBOT_HELP_TEXT=Custom help text here

# n8n Basic Auth (optional, recommended for production)
N8N_BASIC_AUTH_ACTIVE=false
N8N_USER=admin
N8N_PASSWORD=changeme

# Container uid/gid (optional)
# The bot images run as the distroless nonroot user (65532), but ./dmbot/data
# and ./roombot/data are bind-mounted from the host and owned by you. Compose
# runs the bots as the uid/gid below so they can still write bot-storage.json.
# Defaults to 1000:1000; set these if `id -u` / `id -g` differ on your host.
DOCKER_UID=1000
DOCKER_GID=1000
